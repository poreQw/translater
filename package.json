{
  "name": "translater",
  "version": "1.0.0",
  "description": "Desktop translation application",
  "main": "main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poreQw/translater.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/poreQw/translater/issues"
  },
  "homepage": "https://github.com/poreQw/translater#readme",
  "build": {
    "appId": "com.poreqw.translater",
    "productName": "Translater",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "www/**/*",
      "package.json",
      "node_modules/dotenv/**/*",
      "!**/.env*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.7"
  }
}
